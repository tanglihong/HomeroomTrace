# CloudBase 账号登录 — 客户端环境变量
# 复制为 .env.local 并填写实际值

# CloudBase 环境 ID（文档/预留）
NEXT_PUBLIC_TCB_ENV_ID=your-env-id

# 云函数 HTTP 访问根 URL（不含末尾斜杠）
# 示例：https://your-env-id.ap-shanghai.app.tcloudbase.com
NEXT_PUBLIC_AUTH_API_BASE=https://your-env-id.ap-shanghai.app.tcloudbase.com

# License 验签公钥（cloudbase/keys/public.pem 内容，换行用 \n）
NEXT_PUBLIC_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
